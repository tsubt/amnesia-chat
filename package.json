{
  "name": "amnesia-chat",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:server": "npm run dev --workspace @amnesia-chat/server",
    "build": "npm run build --workspace web",
    "start": "bun run apps/server/src/index.ts",
    "start:server": "bun run apps/server/src/index.ts"
  }
}
